generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://geouser:geopassword@127.0.0.1:5432/geomesh?schema=public"
}

model Tenant {
  id               String             @id @default(cuid())
  name             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  agentLimit       Int                @default(5)
  assetLimit       Int                @default(100)
  status           String             @default("active")
  adminEmail       String?
  logoUrl          String?
  alerts           Alert[]
  anchors          Anchor[]
  assets           Asset[]
  DashboardSection DashboardSection[]
  gateways         Gateway[]
  rules            RuleFlow[]
  sites            Site[]
  users            User[]
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String?  @default("geomesh123")
  name       String?
  role       String   @default("operator")
  isVerified Boolean  @default(true)
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Site {
  id        String   @id @default(cuid())
  name      String
  address   String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zones     Zone[]
}

model Zone {
  id           String     @id @default(cuid())
  name         String
  floorPlanUrl String?
  width        Float      @default(100.0)
  height       Float      @default(100.0)
  siteId       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  offsetX      Float      @default(0.0)
  offsetY      Float      @default(0.0)
  anchors      Anchor[]
  assets       Asset[]
  geofences    Geofence[]
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Gateway {
  id        String   @id
  name      String
  status    String   @default("offline")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Anchor {
  id        String   @id
  name      String
  x         Float    @default(0.0)
  y         Float    @default(0.0)
  status    String   @default("offline")
  tenantId  String
  zoneId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone      Zone?    @relation(fields: [zoneId], references: [id])
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("static")
  tenantId    String
  zoneId      String?
  tagId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  latitude    Float?
  longitude   Float?
  type        String   @default("FORKLIFT")
  parentId    String?
  planX       Float?
  planY       Float?
  alerts      Alert[]
  parent      Asset?   @relation("AssetToAsset", fields: [parentId], references: [id])
  children    Asset[]  @relation("AssetToAsset")
  tag         Tag?     @relation(fields: [tagId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone        Zone?    @relation(fields: [zoneId], references: [id])
}

model Tag {
  id          String    @id
  name        String?
  battery     Float?
  rssi        Int?
  temperature Float?
  humidity    Float?
  lastSeen    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  signals     String?
  asset       Asset?
}

model Alert {
  id         String    @id @default(cuid())
  type       String
  message    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  tenantId   String
  assetId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  asset      Asset?    @relation(fields: [assetId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Geofence {
  id        String   @id @default(cuid())
  name      String
  points    String
  color     String   @default("#ef4444")
  type      String   @default("RESTRICTED")
  zoneId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Telemetry {
  timestamp   DateTime
  tagId       String
  temperature Float?
  humidity    Float?
  battery     Float?
  rssi        Int?
  accelX      Float?
  accelY      Float?
  accelZ      Float?
  pitch       Float?
  roll        Float?
  hall        Int?

  @@id([timestamp, tagId])
}

model TelemetryLog {
  timestamp DateTime
  tagId     String
  attrName  String
  value     Float

  @@id([timestamp, tagId, attrName])
}

model RuleFlow {
  id         String    @id @default(cuid())
  name       String
  isActive   Boolean   @default(true)
  flowGraph  String?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ruleConfig String?
  ruleType   String    @default("FLOW")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs       RuleLog[]
}

model RuleLog {
  id        String   @id @default(cuid())
  ruleId    String
  status    String
  message   String
  createdAt DateTime @default(now())
  rule      RuleFlow @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DashboardSection {
  id        String            @id @default(cuid())
  name      String
  order     Int               @default(0)
  layout    String?
  tenantId  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]
}

model DashboardWidget {
  id        String           @id @default(cuid())
  type      String
  config    String?
  sectionId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  section   DashboardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}
