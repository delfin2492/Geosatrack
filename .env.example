# ==============================================================================
# TEMPLATE LINGKUNGAN PENGEMBANGAN (DEVELOPMENT ENVIRONMENT TEMPLATE)
# Salin file ini menjadi `.env` di lingkungan lokal Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + TimescaleDB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=geouser
DB_PASSWORD=geopassword
DB_NAME=geosatrack

# Koneksi Database URL untuk Prisma ORM
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE CONFIGURATION (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MQTT BROKER CONFIGURATION (EMQX)
# ------------------------------------------------------------------------------
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=admin_geosatrack
MQTT_PASSWORD=admin_geosatrack

# ------------------------------------------------------------------------------
# 4. IDENTITY & ACCESS MANAGEMENT (Keycloak)
# ------------------------------------------------------------------------------
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM=geosatrack
KEYCLOAK_CLIENT_ID=geosatrack-app
KEYCLOAK_CLIENT_SECRET=change-me-on-production

# ------------------------------------------------------------------------------
# 5. BACKEND APPLICATION CONFIGURATION (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-me

# ------------------------------------------------------------------------------
# 6. FRONTEND APPLICATION CONFIGURATION (Next.js 15)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM=geosatrack
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=geosatrack-frontend
